### university/major domain — MajorController
### 인증 불필요 (SecurityConfig permitAll: /universities/**). 시드 데이터: univ-inu (V4__add_major.sql).

### 1. 학교 전체 전공 목록 조회 (query 생략)
GET {{host}}/universities/univ-inu/majors

> {%
client.test("전공 목록 200 + 시드 10개 이상", function() {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.success === true, "success should be true");
    client.assert(Array.isArray(response.body.data), "data should be an array");
    client.assert(response.body.data.length >= 10, "expected at least 10 seeded majors, got " + response.body.data.length);
    const first = response.body.data[0];
    client.assert(typeof first.id === "string" && first.id.length > 0, "major.id should be a non-empty string");
    client.assert(typeof first.name === "string" && first.name.length > 0, "major.name should be a non-empty string");
});
%}

### 2. 전공 자동완성 (query="컴퓨터")
GET {{host}}/universities/univ-inu/majors?query=컴퓨터

> {%
client.test("검색어로 필터링된 전공만 반환", function() {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.data.length >= 1, "expected at least 1 match for '컴퓨터'");
    response.body.data.forEach(function (major) {
        client.assert(major.name.indexOf("컴퓨터") !== -1, "unexpected major in filtered result: " + major.name);
    });
});
%}

### 3. 존재하지 않는 학교 ID -> 400 INVALID_INPUT
GET {{host}}/universities/univ-does-not-exist/majors

> {%
client.test("존재하지 않는 university_id는 400 INVALID_INPUT", function() {
    client.assert(response.status === 400, "expected 400, got " + response.status);
    client.assert(response.body.success === false, "success should be false");
    client.assert(response.body.error.code === "INVALID_INPUT", "expected INVALID_INPUT, got " + response.body.error.code);
});
%}
