%}

### 4. 회원가입 - 비밀번호 형식 위반(숫자 없음) -> 400 INVALID_INPUT
POST {{host}}/auth/students/signup
Content-Type: application/json

{
  "login_id": "qa{{runId}}bad",
  "email": "qa{{runId}}bad@inu.ac.kr",
  "name": "QA Student Bad",
  "password": "onlyletters",
  "country": "KR",
  "language": "ko",
  "student_type": "정규과정생",
  "university_id": "univ-inu",
  "terms_agreed": true,
  "privacy_agreed": true
}

> {%
client.test("비밀번호 형식 위반 400 INVALID_INPUT", function () {
    client.assert(response.status === 400, "expected 400, got " + response.status);
    client.assert(response.body.error.code === "INVALID_INPUT", "expected INVALID_INPUT, got " + response.body.error.code);
});
%}

