### student auth domain — StudentAuthController (/auth/students/**, 전부 permitAll)
### 알려진 한계: 이메일 인증 코드는 StubEmailService가 서버 로그에만 남기고 조회 API가 없어서,
### "정확한 코드로 성공"하는 해피패스는 자동 검증할 수 없다. 코드 발송 성공 / 틀린 코드 에러까지만 검증한다.

### 1. 회원가입 성공 (runId로 매 실행마다 유니크한 login_id/email 생성)
< {%
    const runId = Date.now();
    request.variables.set("runId", runId);
    client.global.set("runId", runId);
    client.global.set("studentLoginId", "qa" + runId);
    client.global.set("studentEmail", "qa" + runId + "@inu.ac.kr");
    client.global.set("studentPassword", "qaPass1234");
%}
POST {{host}}/auth/students/signup
Content-Type: application/json

{
  "login_id": "{{studentLoginId}}",
  "email": "{{studentEmail}}",
  "name": "QA Student",
  "password": "{{studentPassword}}",
  "country": "KR",
  "language": "ko",
  "student_type": "정규과정생",
  "major": "컴퓨터공학부",
  "grade": "1학년",
  "birth_year": 2001,
  "university_id": "univ-inu",
  "terms_agreed": true,
  "privacy_agreed": true
}

> {%
client.test("회원가입 성공 201", function () {
    client.assert(response.status === 201, "expected 201, got " + response.status);
    client.assert(response.body.success === true, "success should be true");
    client.assert(typeof response.body.data.id === "string" && response.body.data.id.length > 0, "data.id should be present");
    client.assert(response.body.data.name === "QA Student", "name should echo back");
});
client.global.set("studentId", response.body.data.id);
%}

### 2. 회원가입 - login_id 중복 -> 409 DUPLICATE_LOGIN_ID
POST {{host}}/auth/students/signup
Content-Type: application/json

{
  "login_id": "{{studentLoginId}}",
  "email": "qa{{runId}}dup@inu.ac.kr",
  "name": "QA Student Dup",
  "password": "qaPass1234",
  "country": "KR",
  "language": "ko",
  "student_type": "정규과정생",
  "university_id": "univ-inu",
  "terms_agreed": true,
  "privacy_agreed": true
}

> {%
client.test("login_id 중복 409", function () {
    client.assert(response.status === 409, "expected 409, got " + response.status);
    client.assert(response.body.error.code === "DUPLICATE_LOGIN_ID", "expected DUPLICATE_LOGIN_ID, got " + response.body.error.code);
});
%}

