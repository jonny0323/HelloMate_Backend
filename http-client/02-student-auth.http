    client.assert(response.body.success === true, "success should be true");
});
%}

### 11. 가입 이메일 인증코드 발송 - 학교 이메일 아님 -> 400 INVALID_INPUT
POST {{host}}/auth/students/email-verifications
Content-Type: application/json

{ "email": "qa{{runId}}@gmail.com" }

> {%
client.test("비학교 이메일 400 INVALID_INPUT", function () {
    client.assert(response.status === 400, "expected 400, got " + response.status);
    client.assert(response.body.error.code === "INVALID_INPUT", "expected INVALID_INPUT, got " + response.body.error.code);
});
%}

### 12. 가입 이메일 인증코드 확인 - 틀린 코드 -> 400 INVALID_VERIFICATION_CODE
### (알려진 한계: 실제 코드는 서버 로그에만 있어 해피패스는 자동화 불가 — 오류 경로만 검증)
POST {{host}}/auth/students/email-verifications/confirm
Content-Type: application/json

{ "email": "{{studentEmail}}", "code": "000000" }

> {%
client.test("틀린 인증코드 400 INVALID_VERIFICATION_CODE", function () {
    client.assert(response.status === 400, "expected 400, got " + response.status);
    client.assert(response.body.error.code === "INVALID_VERIFICATION_CODE", "expected INVALID_VERIFICATION_CODE, got " + response.body.error.code);
});
%}

### 13. 로그인 성공
POST {{host}}/auth/students/login
Content-Type: application/json

{
  "login_id": "{{studentLoginId}}",
  "password": "{{studentPassword}}",
  "auto_login": false
}

> {%
client.test("로그인 성공 200 + 토큰 발급", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(typeof response.body.data.access_token === "string" && response.body.data.access_token.length > 0, "access_token should be present");
    client.assert(typeof response.body.data.refresh_token === "string" && response.body.data.refresh_token.length > 0, "refresh_token should be present");
});
client.global.set("studentAccessToken", response.body.data.access_token);
client.global.set("studentRefreshToken", response.body.data.refresh_token);
%}

### 14. 로그인 - 비밀번호 틀림 -> 401 INVALID_CREDENTIALS
POST {{host}}/auth/students/login
Content-Type: application/json

{ "login_id": "{{studentLoginId}}", "password": "wrongPassword1", "auto_login": false }

> {%
client.test("비밀번호 틀림 401", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
    client.assert(response.body.error.code === "INVALID_CREDENTIALS", "expected INVALID_CREDENTIALS, got " + response.body.error.code);
});
%}

### 15. 로그인 - 존재하지 않는 아이디 -> 401 INVALID_CREDENTIALS (계정 존재 여부 구분 안 함)
POST {{host}}/auth/students/login
Content-Type: application/json

{ "login_id": "qa{{runId}}nosuch", "password": "wrongPassword1", "auto_login": false }

> {%
client.test("존재하지 않는 아이디도 401 동일 메시지", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
    client.assert(response.body.error.code === "INVALID_CREDENTIALS", "expected INVALID_CREDENTIALS, got " + response.body.error.code);
});
%}

### 16. 리프레시 토큰 재발급 성공
POST {{host}}/auth/students/refresh
Content-Type: application/json

{ "refresh_token": "{{studentRefreshToken}}" }

> {%
client.test("리프레시 성공 200 + 새 토큰", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(typeof response.body.data.access_token === "string" && response.body.data.access_token.length > 0, "access_token should be present");
    client.assert(response.body.data.refresh_token !== "{{studentRefreshToken}}", "refresh token should rotate");
});
%}

### 17. 리프레시 - 형식 자체가 잘못된 토큰 -> 401 INVALID_REFRESH_TOKEN
POST {{host}}/auth/students/refresh
Content-Type: application/json

{ "refresh_token": "not-a-real-jwt" }

> {%
client.test("잘못된 형식 토큰 401", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
    client.assert(response.body.error.code === "INVALID_REFRESH_TOKEN", "expected INVALID_REFRESH_TOKEN, got " + response.body.error.code);
});
%}

### 18. 리프레시 - access 토큰으로 시도 -> 401 INVALID_REFRESH_TOKEN (type 클레임 불일치)
POST {{host}}/auth/students/refresh
Content-Type: application/json

{ "refresh_token": "{{studentAccessToken}}" }

> {%
client.test("access 토큰으로 refresh 시도 401", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
    client.assert(response.body.error.code === "INVALID_REFRESH_TOKEN", "expected INVALID_REFRESH_TOKEN, got " + response.body.error.code);
});
%}

### 19. 로그아웃 성공
POST {{host}}/auth/students/logout
Authorization: Bearer {{studentAccessToken}}

> {%
client.test("로그아웃 200", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.success === true, "success should be true");
    client.assert(response.body.data === null || response.body.data === undefined, "data should be null/absent (Jackson non_null omits it from JSON)");
});
%}

