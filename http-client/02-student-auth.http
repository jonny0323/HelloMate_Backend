    client.assert(response.body.error.code === "INVALID_INPUT", "expected INVALID_INPUT, got " + response.body.error.code);
});
%}

### 6. 아이디 중복 확인 - 사용 가능
POST {{host}}/auth/students/check-login-id
Content-Type: application/json

{ "login_id": "qa{{runId}}avail" }

> {%
client.test("사용 가능한 아이디 200", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.data.available === true, "available should be true");
});
%}

