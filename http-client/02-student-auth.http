### 23. 비밀번호 재설정 - 잘못된/만료된 resetToken -> 401 INVALID_RESET_TOKEN
PATCH {{host}}/auth/students/password-reset
Content-Type: application/json

{ "reset_token": "not-a-real-reset-token", "new_password": "newPass1234" }

> {%
client.test("잘못된 resetToken 401", function () {
    client.assert(response.status === 401, "expected 401, got " + response.status);
    client.assert(response.body.error.code === "INVALID_RESET_TOKEN", "expected INVALID_RESET_TOKEN, got " + response.body.error.code);
});
%}
