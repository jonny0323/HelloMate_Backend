### chat domain — ChatController (/chats/**), 1:1 학생-담당자 문의
### 사전 준비: seed-invite-codes.sql (초대 코드 HTTP-TEST-CHAT)

### 1. 담당자(상담원) 회원가입
< {%
    const runId = Date.now();
    client.global.set("runId", runId);
%}
POST {{host}}/auth/staff/signup
Content-Type: application/json

{
  "invite_code": "HTTP-TEST-CHAT",
  "email": "chatstaff{{runId}}@inu.ac.kr",
  "name": "QA Chat Staff",
  "position": "주임",
  "password": "qaStaffPass1234"
}

> {%
client.test("담당자 가입 201", function () { client.assert(response.status === 201); });
client.global.set("staffId", response.body.data.id);
%}

### 2. 담당자 로그인
POST {{host}}/auth/staff/login
Content-Type: application/json

{ "email": "chatstaff{{runId}}@inu.ac.kr", "password": "qaStaffPass1234" }

> {%
client.test("담당자 로그인 200", function () { client.assert(response.status === 200); });
client.global.set("staffAccessToken", response.body.data.access_token);
%}

