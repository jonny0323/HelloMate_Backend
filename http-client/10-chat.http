### 16. 학생 C - 남의 스레드 메시지 조회 시도 -> 403 FORBIDDEN
GET {{host}}/chats/threads/{{threadId}}/messages
Authorization: Bearer {{tokenC}}

> {%
client.test("당사자가 아닌 학생 접근 403 FORBIDDEN", function () {
    client.assert(response.status === 403, "expected 403, got " + response.status);
    client.assert(response.body.error.code === "FORBIDDEN", "expected FORBIDDEN, got " + response.body.error.code);
});
%}

### 17. 학생 C - 남의 스레드에 메시지 전송 시도 -> 403 FORBIDDEN
POST {{host}}/chats/threads/{{threadId}}/messages
Authorization: Bearer {{tokenC}}
Content-Type: application/json

{ "content": "끼어들기" }

> {%
client.test("당사자가 아닌 학생 메시지 전송 403 FORBIDDEN", function () {
    client.assert(response.status === 403, "expected 403, got " + response.status);
    client.assert(response.body.error.code === "FORBIDDEN", "expected FORBIDDEN, got " + response.body.error.code);
});
%}

### 18. 존재하지 않는 스레드 조회 -> 404 CHAT_THREAD_NOT_FOUND
GET {{host}}/chats/threads/thread-does-not-exist-{{runId}}/messages
Authorization: Bearer {{tokenA}}

> {%
client.test("존재하지 않는 스레드 404", function () {
    client.assert(response.status === 404, "expected 404, got " + response.status);
    client.assert(response.body.error.code === "CHAT_THREAD_NOT_FOUND", "expected CHAT_THREAD_NOT_FOUND, got " + response.body.error.code);
});
%}

