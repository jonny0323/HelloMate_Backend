### 17. 대댓글 작성 (A, parent=B의 댓글)
POST {{host}}/posts/{{postId}}/comments
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{ "content": "A의 대댓글입니다.", "parent_comment_id": "{{commentId}}" }

> {%
client.test("대댓글 작성 201", function () {
    client.assert(response.status === 201, "expected 201, got " + response.status);
    client.assert(response.body.data.parent_comment_id === "{{commentId}}", "parent_comment_id should match");
});
client.global.set("replyId", response.body.data.id);
%}

