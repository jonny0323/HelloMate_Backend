### 5. 게시글 작성 (A, 익명)
POST {{host}}/posts
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{ "title": "QA 게시글 {{runId}}", "content": "테스트용 게시글 본문입니다.", "anonymous": true }

> {%
client.test("게시글 작성 201, 익명 처리", function () {
    client.assert(response.status === 201, "expected 201, got " + response.status);
    client.assert(response.body.data.anonymous === true, "anonymous should be true");
    client.assert(response.body.data.author_name.indexOf("익명") === 0, "author_name should start with 익명");
});
client.global.set("postId", response.body.data.id);
%}

### 6. 게시글 목록 검색 (q로 방금 쓴 글 찾기)
GET {{host}}/posts?q=QA 게시글 {{runId}}
Authorization: Bearer {{tokenA}}

> {%
client.test("검색어로 방금 쓴 글을 찾음", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    const found = response.body.data.some(function (p) { return p.id === "{{postId}}"; });
    client.assert(found, "created post should appear in search results");
});
%}

### 7. 내가 쓴 글 목록 (A)
GET {{host}}/posts/mine
Authorization: Bearer {{tokenA}}

> {%
client.test("내 글 목록에 포함", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    const found = response.body.data.some(function (p) { return p.id === "{{postId}}"; });
    client.assert(found, "created post should appear in /posts/mine");
});
%}

### 8. 게시글 상세 조회 (B) - mine=false
GET {{host}}/posts/{{postId}}
Authorization: Bearer {{tokenB}}

> {%
client.test("타인이 보면 mine=false", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.data.mine === false, "mine should be false for B");
    client.assert(response.body.data.liked_by_me === false, "liked_by_me should be false initially");
    client.assert(response.body.data.comment_count === 0, "comment_count should start at 0");
});
%}

### 9. 게시글 상세 조회 (A) - mine=true
GET {{host}}/posts/{{postId}}
Authorization: Bearer {{tokenA}}

> {%
client.test("작성자가 보면 mine=true", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.data.mine === true, "mine should be true for author A");
});
%}

### 10. 게시글 수정 - 작성자가 아닌 B가 시도 -> 403 FORBIDDEN
PATCH {{host}}/posts/{{postId}}
Authorization: Bearer {{tokenB}}
Content-Type: application/json

{ "title": "해킹 시도", "content": "해킹 시도 본문" }

> {%
client.test("비작성자 수정 시도 403", function () {
    client.assert(response.status === 403, "expected 403, got " + response.status);
    client.assert(response.body.error.code === "FORBIDDEN", "expected FORBIDDEN, got " + response.body.error.code);
});
%}

### 11. 게시글 수정 - 작성자 A 성공
PATCH {{host}}/posts/{{postId}}
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{ "title": "QA 게시글 {{runId}} (수정됨)", "content": "수정된 본문입니다." }

> {%
client.test("작성자 수정 200 반영", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.data.content === "수정된 본문입니다.", "content should be updated");
});
%}

