### 7. 학생 A - 클럽 생성
POST {{host}}/clubs
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{ "title": "QA 클럽 {{runId}}", "introduction": "테스트용 클럽입니다.", "max_members": 10, "deadline": "2099-12-31" }

> {%
client.test("클럽 생성 201 - 생성자 자동 참여", function () {
    client.assert(response.status === 201, "expected 201, got " + response.status);
    client.assert(response.body.data.current_members === 1, "creator should auto-join, current_members=1");
    client.assert(response.body.data.card_state === "joined", "card_state should be joined for the creator");
    client.assert(response.body.data.full === false, "should not be full yet");
});
client.global.set("clubId", response.body.data.id);
%}

### 8. 클럽 생성 - 과거 마감일 -> 400 INVALID_INPUT
POST {{host}}/clubs
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{ "title": "과거 마감 클럽", "introduction": "실패해야 함", "max_members": 5, "deadline": "2020-01-01" }

> {%
client.test("과거 마감일 400 INVALID_INPUT", function () {
    client.assert(response.status === 400, "expected 400, got " + response.status);
    client.assert(response.body.error.code === "INVALID_INPUT", "expected INVALID_INPUT, got " + response.body.error.code);
});
%}

### 9. 클럽 목록 조회 (A) - 방금 만든 클럽 포함
GET {{host}}/clubs
Authorization: Bearer {{tokenA}}

> {%
client.test("클럽 목록에 방금 만든 클럽 포함", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    const found = response.body.data.some(function (c) { return c.id === "{{clubId}}"; });
    client.assert(found, "created club should appear in list");
});
%}

### 10. 내 클럽 목록 조회 (A)
GET {{host}}/clubs/mine
Authorization: Bearer {{tokenA}}

> {%
client.test("내 클럽 목록에 포함", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    const found = response.body.data.some(function (c) { return c.id === "{{clubId}}"; });
    client.assert(found, "created club should appear in /clubs/mine");
});
%}

### 11. 클럽 상세 조회 (B, 아직 미참여) - card_state=joinable
GET {{host}}/clubs/{{clubId}}
Authorization: Bearer {{tokenB}}

> {%
client.test("미참여 학생에게는 joinable로 보임", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.data.card_state === "joinable", "expected joinable, got " + response.body.data.card_state);
});
%}

### 12. 클럽 상세 조회 - 존재하지 않는 클럽 -> 404 CLUB_NOT_FOUND
GET {{host}}/clubs/club-does-not-exist-{{runId}}
Authorization: Bearer {{tokenA}}

> {%
client.test("존재하지 않는 클럽 404", function () {
    client.assert(response.status === 404, "expected 404, got " + response.status);
    client.assert(response.body.error.code === "CLUB_NOT_FOUND", "expected CLUB_NOT_FOUND, got " + response.body.error.code);
});
%}

### 13. 클럽 수정 - 개설자가 아닌 학생이 시도 -> 403 FORBIDDEN
