### 20. 클럽 그룹 채팅 메시지 전송 (B)
POST {{host}}/clubs/{{clubId}}/messages
Authorization: Bearer {{tokenB}}
Content-Type: application/json

{ "content": "안녕하세요! B입니다." }

> {%
client.test("메시지 전송 201", function () {
    client.assert(response.status === 201, "expected 201, got " + response.status);
    client.assert(response.body.data.content === "안녕하세요! B입니다.", "content should echo back");
    client.assert(response.body.data.sender_id === "{{studentBId}}", "sender_id should be B");
});
%}

