### club domain — ClubController (/clubs/**)

### 1. 클럽장이 될 학생 A 회원가입
< {%
    const runId = Date.now();
    client.global.set("runId", runId);
%}
POST {{host}}/auth/students/signup
Content-Type: application/json

{
  "login_id": "qa{{runId}}a",
  "email": "qa{{runId}}a@inu.ac.kr",
  "name": "QA Club Creator",
  "password": "qaPass1234",
  "country": "KR",
  "language": "ko",
  "student_type": "정규과정생",
  "university_id": "univ-inu",
  "terms_agreed": true,
  "privacy_agreed": true
}

> {%
client.test("학생 A 가입 201", function () { client.assert(response.status === 201); });
%}

