### 22. 클럽 그룹 채팅 메시지 목록 조회 (A)
GET {{host}}/clubs/{{clubId}}/messages
Authorization: Bearer {{tokenA}}

> {%
client.test("메시지 목록에 B의 메시지 포함", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    const found = response.body.data.some(function (m) { return m.content === "안녕하세요! B입니다."; });
    client.assert(found, "B's message should appear in the list");
    client.assert(response.body.meta.size >= 1, "meta.size should be at least 1");
});
%}

