### notice domain — StudentNoticeController (/notices/**, 학생) + AdminNoticeController (/admin/notices/**, 담당자)
### 사전 준비: seed-invite-codes.sql (초대 코드 HTTP-TEST-NOTICE-ADMIN)

### 1. 담당자(작성자) 회원가입
< {%
    const runId = Date.now();
    client.global.set("runId", runId);
%}
POST {{host}}/auth/staff/signup
Content-Type: application/json

{
  "invite_code": "HTTP-TEST-NOTICE-ADMIN",
  "email": "noticestaff{{runId}}@inu.ac.kr",
  "name": "QA Notice Staff",
  "position": "주임",
  "password": "qaStaffPass1234"
}

> {%
client.test("담당자 가입 201", function () { client.assert(response.status === 201); });
%}

### 2. 담당자 로그인
POST {{host}}/auth/staff/login
Content-Type: application/json

{ "email": "noticestaff{{runId}}@inu.ac.kr", "password": "qaStaffPass1234" }

> {%
client.test("담당자 로그인 200", function () { client.assert(response.status === 200); });
client.global.set("staffAccessToken", response.body.data.access_token);
%}

### 3. 학생 회원가입
POST {{host}}/auth/students/signup
Content-Type: application/json

{
  "login_id": "qa{{runId}}nt",
  "email": "qa{{runId}}nt@inu.ac.kr",
  "name": "QA Notice Student",
  "password": "qaPass1234",
  "country": "KR",
  "language": "ko",
  "student_type": "정규과정생",
  "university_id": "univ-inu",
  "terms_agreed": true,
  "privacy_agreed": true
}

> {%
client.test("학생 가입 201", function () { client.assert(response.status === 201); });
client.global.set("studentId", response.body.data.id);
%}

### 4. 학생 로그인
POST {{host}}/auth/students/login
Content-Type: application/json

{ "login_id": "qa{{runId}}nt", "password": "qaPass1234", "auto_login": false }

> {%
client.test("학생 로그인 200", function () { client.assert(response.status === 200); });
client.global.set("studentAccessToken", response.body.data.access_token);
%}

### 5. 담당자 - 전체 학생 대상 공지 작성 (배너 기간 포함)
POST {{host}}/admin/notices
Authorization: Bearer {{staffAccessToken}}
Content-Type: application/json

{
  "title": "QA 공지 {{runId}}",
  "content": "테스트용 공지 본문입니다.",
  "department": "QA부서{{runId}}",
  "type": "urgent",
  "audience": { "mode": "all" },
  "banner_start_date": "2020-01-01",
  "banner_end_date": "2099-12-31"
}

> {%
client.test("공지 작성 201 - 수신자 1명 이상", function () {
    client.assert(response.status === 201, "expected 201, got " + response.status);
    client.assert(response.body.data.total_recipient_count >= 1, "total_recipient_count should be at least 1");
});
client.global.set("noticeId", response.body.data.id);
%}

### 6. 담당자 - 존재하지 않는 첨부파일 id로 공지 작성 -> 404 FILE_NOT_FOUND
POST {{host}}/admin/notices
Authorization: Bearer {{staffAccessToken}}
Content-Type: application/json

{
  "title": "실패해야 함",
  "content": "본문",
  "department": "QA부서{{runId}}",
  "type": "normal",
  "audience": { "mode": "all" },
  "files": ["file-does-not-exist-{{runId}}"]
}

> {%
client.test("존재하지 않는 첨부파일 404 FILE_NOT_FOUND", function () {
    client.assert(response.status === 404, "expected 404, got " + response.status);
    client.assert(response.body.error.code === "FILE_NOT_FOUND", "expected FILE_NOT_FOUND, got " + response.body.error.code);
});
%}

### 7. 담당자 - 개별 학생 대상 공지 작성 (수신자 1명 고정 확인)
POST {{host}}/admin/notices
Authorization: Bearer {{staffAccessToken}}
Content-Type: application/json

{
  "title": "QA 개별 공지 {{runId}}",
  "content": "개별 수신 테스트",
  "department": "QA부서{{runId}}",
  "type": "normal",
  "audience": { "mode": "individual", "student_ids": ["{{studentId}}"] }
}

> {%
client.test("개별 공지 작성 201 - 수신자 정확히 1명", function () {
    client.assert(response.status === 201, "expected 201, got " + response.status);
    client.assert(response.body.data.total_recipient_count === 1, "expected exactly 1 recipient, got " + response.body.data.total_recipient_count);
});
client.global.set("individualNoticeId", response.body.data.id);
%}

### 8. 학생 - 공지 홈 (배너 + 최근 공지)
GET {{host}}/notices/home
Authorization: Bearer {{studentAccessToken}}

> {%
client.test("공지 홈에 배너/최근 공지 모두 포함", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    const inBanners = response.body.data.banners.some(function (b) { return b.id === "{{noticeId}}"; });
    client.assert(inBanners, "notice with active banner window should appear in banners");
    const inRecent = response.body.data.recent_notices.some(function (n) { return n.id === "{{noticeId}}"; });
    client.assert(inRecent, "notice should appear in recent_notices");
});
%}

### 9. 학생 - 공지 목록 조회 (읽기 전)
GET {{host}}/notices
Authorization: Bearer {{studentAccessToken}}

> {%
client.test("공지 목록에 포함, 아직 안읽음", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    const target = response.body.data.filter(function (n) { return n.id === "{{noticeId}}"; })[0];
    client.assert(target !== undefined, "notice should be in the list");
    client.assert(target.is_read === false, "should not be read yet");
});
%}

### 10. 학생 - 공지 목록 검색
GET {{host}}/notices?q=QA 공지 {{runId}}
Authorization: Bearer {{studentAccessToken}}

> {%
client.test("검색어로 공지를 찾음", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    const found = response.body.data.some(function (n) { return n.id === "{{noticeId}}"; });
    client.assert(found, "notice should be found by title keyword");
});
%}

### 11. 학생 - 안읽은 공지 수
GET {{host}}/notices/unread-count
Authorization: Bearer {{studentAccessToken}}

> {%
client.test("안읽은 공지 수 2 이상 (전체+개별)", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.data.count >= 2, "expected at least 2 unread notices, got " + response.body.data.count);
});
%}

### 12. 학생 - 공지 상세 조회 (읽음 처리 겸함)
GET {{host}}/notices/{{noticeId}}
Authorization: Bearer {{studentAccessToken}}

> {%
client.test("상세 조회 200 - 읽음 처리됨", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.data.title === "QA 공지 {{runId}}", "title should match");
    client.assert(response.body.data.is_read === true, "should be marked read after viewing detail");
});
%}

### 13. 학생 - 공지 첨부파일 목록 (없음 -> 빈 배열)
GET {{host}}/notices/{{noticeId}}/files
Authorization: Bearer {{studentAccessToken}}

> {%
client.test("첨부파일 없는 공지는 빈 배열 200", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(Array.isArray(response.body.data), "data should be an array");
    client.assert(response.body.data.length === 0, "expected no attachments");
});
%}

### 14. 학생 - 읽음 처리 재요청 (멱등)
PATCH {{host}}/notices/{{noticeId}}/read
Authorization: Bearer {{studentAccessToken}}

> {%
client.test("이미 읽은 공지 읽음 처리 재요청도 200", function () { client.assert(response.status === 200); });
%}

### 15. 학생 - 존재하지 않는 공지 조회 -> 404 NOTICE_NOT_FOUND
GET {{host}}/notices/notice-does-not-exist-{{runId}}
Authorization: Bearer {{studentAccessToken}}

> {%
client.test("존재하지 않는 공지 404", function () {
    client.assert(response.status === 404, "expected 404, got " + response.status);
    client.assert(response.body.error.code === "NOTICE_NOT_FOUND", "expected NOTICE_NOT_FOUND, got " + response.body.error.code);
});
%}

### 16. 담당자 - 발송한 공지 목록 (부서 필터)
GET {{host}}/admin/notices?department=QA부서{{runId}}&page=1&size=20
Authorization: Bearer {{staffAccessToken}}

> {%
client.test("담당자 발송 목록에 포함, 읽음 수 반영", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    const target = response.body.data.filter(function (n) { return n.id === "{{noticeId}}"; })[0];
    client.assert(target !== undefined, "notice should appear in admin sent list");
    client.assert(target.read_count >= 1, "read_count should reflect the student who viewed it");
    client.assert(target.read_rate > 0, "read_rate should be greater than 0");
});
%}

### 17. 담당자 - 공지 상세
GET {{host}}/admin/notices/{{noticeId}}
Authorization: Bearer {{staffAccessToken}}

> {%
client.test("담당자 공지 상세 200", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.data.title === "QA 공지 {{runId}}", "title should match");
    client.assert(response.body.data.read_count >= 1, "read_count should be at least 1");
});
%}

### 18. 담당자 - 수신자별 읽음 현황
GET {{host}}/admin/notices/{{noticeId}}/receptions
Authorization: Bearer {{staffAccessToken}}

> {%
client.test("수신자 현황에 학생이 읽음으로 표시됨", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    const target = response.body.data.filter(function (r) { return r.student_id === "{{studentId}}"; })[0];
    client.assert(target !== undefined, "student should be in receptions list");
    client.assert(target.is_read === true, "should be marked as read");
});
%}

### 19. 담당자 - 공지 재발송 (읽음 상태 초기화)
POST {{host}}/admin/notices/{{noticeId}}/resend
Authorization: Bearer {{staffAccessToken}}

> {%
client.test("재발송 200", function () { client.assert(response.status === 200); });
%}

### 20. 담당자 - 재발송 후 읽음 상태가 초기화됐는지 확인
GET {{host}}/admin/notices/{{noticeId}}/receptions
Authorization: Bearer {{staffAccessToken}}

> {%
client.test("재발송 후 다시 안읽음 상태", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    const target = response.body.data.filter(function (r) { return r.student_id === "{{studentId}}"; })[0];
    client.assert(target.is_read === false, "resend should reset read flag back to unread");
});
%}

### 21. 담당자 - 존재하지 않는 공지 재발송 -> 404 NOTICE_NOT_FOUND
POST {{host}}/admin/notices/notice-does-not-exist-{{runId}}/resend
Authorization: Bearer {{staffAccessToken}}

