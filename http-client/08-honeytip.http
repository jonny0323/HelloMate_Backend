### honey-tip domain — HoneyTipController (/honey-tips/**, 학생) + AdminHoneyTipController (/admin/honey-tips/**, 담당자)
### 사전 준비: seed-invite-codes.sql (초대 코드 HTTP-TEST-HONEYTIP-ADMIN)

### 1. 담당자(작성자) 회원가입
< {%
    const runId = Date.now();
    client.global.set("runId", runId);
%}
POST {{host}}/auth/staff/signup
Content-Type: application/json

{
  "invite_code": "HTTP-TEST-HONEYTIP-ADMIN",
  "email": "honeytipstaff{{runId}}@inu.ac.kr",
  "name": "QA HoneyTip Staff",
  "position": "주임",
  "password": "qaStaffPass1234"
}

> {%
client.test("담당자 가입 201", function () { client.assert(response.status === 201); });
%}

### 2. 담당자 로그인
POST {{host}}/auth/staff/login
Content-Type: application/json

{ "email": "honeytipstaff{{runId}}@inu.ac.kr", "password": "qaStaffPass1234" }

> {%
client.test("담당자 로그인 200", function () { client.assert(response.status === 200); });
client.global.set("staffAccessToken", response.body.data.access_token);
%}

### 3. 학생 회원가입
POST {{host}}/auth/students/signup
Content-Type: application/json

{
  "login_id": "qa{{runId}}ht",
