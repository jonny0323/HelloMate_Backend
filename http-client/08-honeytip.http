    client.assert(response.body.error.code === "HONEY_TIP_NOT_FOUND", "expected HONEY_TIP_NOT_FOUND, got " + response.body.error.code);
});
%}

### 11. 학생 - 정보 수정 요청 보내기
POST {{host}}/honey-tips/{{honeyTipId}}/edit-requests
Authorization: Bearer {{studentAccessToken}}
Content-Type: application/json

{ "content": "수수료가 실제로는 다른 것 같아요, 확인 부탁드려요." }

> {%
client.test("수정 요청 제출 201", function () { client.assert(response.status === 201); });
%}

### 12. 정보 수정 요청 - 존재하지 않는 정보글 -> 404 HONEY_TIP_NOT_FOUND
POST {{host}}/honey-tips/tip-does-not-exist-{{runId}}/edit-requests
Authorization: Bearer {{studentAccessToken}}
Content-Type: application/json

{ "content": "실패해야 함" }

> {%
client.test("존재하지 않는 정보글에 수정 요청 404", function () {
    client.assert(response.status === 404, "expected 404, got " + response.status);
    client.assert(response.body.error.code === "HONEY_TIP_NOT_FOUND", "expected HONEY_TIP_NOT_FOUND, got " + response.body.error.code);
});
%}

### 13. 담당자 - 수정 요청 목록 조회
GET {{host}}/admin/honey-tips/{{honeyTipId}}/edit-requests
Authorization: Bearer {{staffAccessToken}}

> {%
client.test("수정 요청 목록에 방금 제출한 것 포함", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.data.length >= 1, "expected at least 1 edit request");
    const target = response.body.data.filter(function (r) { return r.content.indexOf("수수료가 실제로는") === 0; })[0];
    client.assert(target !== undefined, "submitted edit request should be present");
    client.assert(target.status === "pending", "expected pending, got " + target.status);
    client.assert(target.requester_name === "QA HoneyTip Student", "requester_name should match the student");
});
client.global.set("editRequestId", response.body.data.filter(function (r) { return r.content.indexOf("수수료가 실제로는") === 0; })[0].id);
%}

### 14. 담당자 - 수정 요청 승인 처리
PATCH {{host}}/admin/honey-tips/edit-requests/{{editRequestId}}
Authorization: Bearer {{staffAccessToken}}
Content-Type: application/json

{ "status": "approved" }

> {%
client.test("수정 요청 승인 200", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.data.status === "approved", "expected approved, got " + response.body.data.status);
});
%}

