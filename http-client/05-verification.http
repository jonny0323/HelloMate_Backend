### verification domain — FileController(/files/presigned-url) + VerificationController(/students/me/verification-documents)
### + AdminVerificationController(/admin/verification-documents)
### 사전 준비: seed-invite-codes.sql (초대 코드 HTTP-TEST-VERIFICATION-ADMIN)

### 1. 테스트 학생 회원가입 + 로그인
< {%
    const runId = Date.now();
    client.global.set("runId", runId);
    client.global.set("studentLoginId", "qa" + runId);
    client.global.set("studentEmail", "qa" + runId + "@inu.ac.kr");
%}
POST {{host}}/auth/students/signup
Content-Type: application/json

{
  "login_id": "{{studentLoginId}}",
  "email": "{{studentEmail}}",
  "name": "QA Verify Student",
  "password": "qaPass1234",
  "country": "KR",
  "language": "ko",
  "student_type": "정규과정생",
  "university_id": "univ-inu",
  "terms_agreed": true,
  "privacy_agreed": true
}

> {%
client.test("학생 가입 201", function () { client.assert(response.status === 201); });
%}

### 2. 로그인
POST {{host}}/auth/students/login
Content-Type: application/json

{ "login_id": "{{studentLoginId}}", "password": "qaPass1234", "auto_login": false }

> {%
client.test("로그인 200", function () { client.assert(response.status === 200); });
client.global.set("studentAccessToken", response.body.data.access_token);
%}

### 3. presigned URL 발급 (서류 업로드 전 단계)
POST {{host}}/files/presigned-url
Authorization: Bearer {{studentAccessToken}}
Content-Type: application/json

{ "filename": "student_card.jpg", "content_type": "image/jpeg", "purpose": "verification_document" }

> {%
client.test("presigned URL 발급 200", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(typeof response.body.data.file_id === "string" && response.body.data.file_id.length > 0, "file_id should be present");
    client.assert(typeof response.body.data.upload_url === "string", "upload_url should be present");
    client.assert(typeof response.body.data.file_url === "string", "file_url should be present");
});
client.global.set("uploadedFileId", response.body.data.file_id);
%}

### 4. 서류 인증 제출
POST {{host}}/students/me/verification-documents
Authorization: Bearer {{studentAccessToken}}
Content-Type: application/json

{ "file_id": "{{uploadedFileId}}", "document_type": "student_id" }

> {%
client.test("서류 인증 제출 201, pending 상태", function () {
    client.assert(response.status === 201, "expected 201, got " + response.status);
    client.assert(response.body.data.status === "pending", "expected pending, got " + response.body.data.status);
    client.assert(response.body.data.document_type === "student_id", "expected student_id, got " + response.body.data.document_type);
});
client.global.set("verificationDocId", response.body.data.id);
%}

### 5. 서류 인증 제출 - 존재하지 않는 file_id -> 404 FILE_NOT_FOUND
POST {{host}}/students/me/verification-documents
Authorization: Bearer {{studentAccessToken}}
Content-Type: application/json

{ "file_id": "file-does-not-exist-{{runId}}", "document_type": "student_id" }

> {%
client.test("존재하지 않는 file_id 404 FILE_NOT_FOUND", function () {
    client.assert(response.status === 404, "expected 404, got " + response.status);
    client.assert(response.body.error.code === "FILE_NOT_FOUND", "expected FILE_NOT_FOUND, got " + response.body.error.code);
});
%}

### 6. 내 서류 인증 조회
GET {{host}}/students/me/verification-documents
Authorization: Bearer {{studentAccessToken}}

> {%
client.test("내 서류 인증 조회 200 - 방금 제출한 것과 일치", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.data.id === "{{verificationDocId}}", "id should match submitted document");
    client.assert(response.body.data.status === "pending", "status should still be pending");
});
%}

### 7. 내 학생 인증 상태 조회 - doc_pending
GET {{host}}/students/me/verification-documents/status
Authorization: Bearer {{studentAccessToken}}

> {%
client.test("학생 인증 상태 조회 200 - doc_pending, verified=false", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.data.verification_status === "doc_pending", "expected doc_pending, got " + response.body.data.verification_status);
    client.assert(response.body.data.verified === false, "verified should be false while pending");
    client.assert(response.body.data.latest_document.id === "{{verificationDocId}}", "latest_document should be the submitted one");
});
%}

### 8. 서류를 한 번도 안 낸 학생의 조회 -> 404 VERIFICATION_DOCUMENT_NOT_FOUND (status 엔드포인트는 아님, GET만)
< {%
    request.variables.set("neverSubmittedLoginId", "qa" + client.global.get("runId") + "ns");
%}
POST {{host}}/auth/students/signup
Content-Type: application/json

{
  "login_id": "{{neverSubmittedLoginId}}",
  "email": "qa{{runId}}ns@inu.ac.kr",
  "name": "QA Never Submitted",
  "password": "qaPass1234",
  "country": "KR",
  "language": "ko",
  "student_type": "정규과정생",
  "university_id": "univ-inu",
  "terms_agreed": true,
  "privacy_agreed": true
}

> {%
client.test("두번째 학생 가입 201", function () { client.assert(response.status === 201); });
%}

### 9. (8에서 만든 학생으로 로그인)
POST {{host}}/auth/students/login
Content-Type: application/json

{ "login_id": "{{neverSubmittedLoginId}}", "password": "qaPass1234", "auto_login": false }

> {%
client.test("두번째 학생 로그인 200", function () { client.assert(response.status === 200); });
client.global.set("neverSubmittedToken", response.body.data.access_token);
%}

### 10. 서류를 한 번도 안 낸 학생의 GET -> 404 VERIFICATION_DOCUMENT_NOT_FOUND
GET {{host}}/students/me/verification-documents
Authorization: Bearer {{neverSubmittedToken}}

> {%
client.test("미제출 학생 조회 404", function () {
    client.assert(response.status === 404, "expected 404, got " + response.status);
    client.assert(response.body.error.code === "VERIFICATION_DOCUMENT_NOT_FOUND", "expected VERIFICATION_DOCUMENT_NOT_FOUND, got " + response.body.error.code);
});
%}

### 11. 미제출 학생의 상태 조회는 200 + latest_document null (에러 아님)
GET {{host}}/students/me/verification-documents/status
Authorization: Bearer {{neverSubmittedToken}}

> {%
client.test("미제출 학생 상태 조회는 200, registered, latest_document 없음", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.data.verification_status === "registered", "expected registered, got " + response.body.data.verification_status);
    client.assert(response.body.data.latest_document === null || response.body.data.latest_document === undefined, "latest_document should be null/absent");
});
%}

### 12. 담당자(검토자) 회원가입 + 로그인
POST {{host}}/auth/staff/signup
Content-Type: application/json

{
  "invite_code": "HTTP-TEST-VERIFICATION-ADMIN",
  "email": "verifystaff{{runId}}@inu.ac.kr",
  "name": "QA Verify Reviewer",
  "position": "주임",
  "password": "qaStaffPass1234"
}

> {%
client.test("검토 담당자 가입 201", function () { client.assert(response.status === 201); });
%}

### 13. 담당자 로그인
POST {{host}}/auth/staff/login
Content-Type: application/json

{ "email": "verifystaff{{runId}}@inu.ac.kr", "password": "qaStaffPass1234" }

> {%
client.test("담당자 로그인 200", function () { client.assert(response.status === 200); });
client.global.set("staffAccessToken", response.body.data.access_token);
%}

### 14. 관리자 - 대기 중인 서류 목록 조회
GET {{host}}/admin/verification-documents?status=pending&page=1&size=50
Authorization: Bearer {{staffAccessToken}}

> {%
client.test("대기 서류 목록에 방금 제출한 문서가 포함됨", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    const found = response.body.data.some(function (doc) { return doc.id === "{{verificationDocId}}"; });
    client.assert(found, "submitted document should appear in pending list");
    client.assert(response.body.meta.page === 1, "meta.page should be 1");
});
%}

### 15. 관리자 - 반려 처리인데 reject_reason 누락 -> 400 REJECT_REASON_REQUIRED
PATCH {{host}}/admin/verification-documents/{{verificationDocId}}
Authorization: Bearer {{staffAccessToken}}
Content-Type: application/json

{ "status": "rejected" }

> {%
client.test("반려 사유 누락 400 REJECT_REASON_REQUIRED", function () {
    client.assert(response.status === 400, "expected 400, got " + response.status);
    client.assert(response.body.error.code === "REJECT_REASON_REQUIRED", "expected REJECT_REASON_REQUIRED, got " + response.body.error.code);
});
%}

### 16. 관리자 - 승인 처리
PATCH {{host}}/admin/verification-documents/{{verificationDocId}}
Authorization: Bearer {{staffAccessToken}}
Content-Type: application/json

{ "status": "approved" }

> {%
client.test("승인 처리 200", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.data.status === "approved", "expected approved, got " + response.body.data.status);
    client.assert(response.body.data.reviewed_at !== null, "reviewed_at should be set");
});
%}

### 17. 관리자 - 존재하지 않는 문서 리뷰 -> 404 VERIFICATION_DOCUMENT_NOT_FOUND
PATCH {{host}}/admin/verification-documents/doc-does-not-exist-{{runId}}
Authorization: Bearer {{staffAccessToken}}
Content-Type: application/json

{ "status": "approved" }

> {%
client.test("존재하지 않는 문서 404", function () {
    client.assert(response.status === 404, "expected 404, got " + response.status);
    client.assert(response.body.error.code === "VERIFICATION_DOCUMENT_NOT_FOUND", "expected VERIFICATION_DOCUMENT_NOT_FOUND, got " + response.body.error.code);
});
%}

### 18. 학생 쪽에서 최종 인증 상태 확인 - verified
GET {{host}}/students/me/verification-documents/status
Authorization: Bearer {{studentAccessToken}}

> {%
client.test("승인 후 학생 인증 상태 verified", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.data.verification_status === "verified", "expected verified, got " + response.body.data.verification_status);
    client.assert(response.body.data.verified === true, "verified flag should now be true");
});
%}
