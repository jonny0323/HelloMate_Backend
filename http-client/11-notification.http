### 10. A - 알림 피드 조회 (category=club)
GET {{host}}/notifications?category=club
Authorization: Bearer {{tokenA}}

> {%
client.test("club 카테고리 알림 2개 이상, 링크 정보 정확", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.data.length >= 2, "expected at least 2 club notifications, got " + response.body.data.length);
    const first = response.body.data[0];
    client.assert(first.category === "club", "category should be club");
    client.assert(first.link_type === "club", "link_type should be club");
    client.assert(first.link_id === "{{clubId}}", "link_id should point to the club");
    client.assert(first.read === false, "should start unread");
});
client.global.set("notificationId", response.body.data[0].id);
%}

### 11. A - 알림 피드 조회 (카테고리 없음, 전체)
GET {{host}}/notifications
Authorization: Bearer {{tokenA}}

> {%
client.test("전체 알림 목록에도 포함", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    const found = response.body.data.some(function (n) { return n.id === "{{notificationId}}"; });
    client.assert(found, "notification should appear in the unfiltered feed");
});
%}

### 12. A - 안읽은 알림 수
GET {{host}}/notifications/unread-count
Authorization: Bearer {{tokenA}}

> {%
client.test("안읽은 알림 2개 이상", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.data.count >= 2, "expected at least 2 unread, got " + response.body.data.count);
});
%}

### 13. A - 알림 1개 읽음 처리
PATCH {{host}}/notifications/{{notificationId}}/read
Authorization: Bearer {{tokenA}}

> {%
client.test("알림 읽음 처리 200", function () { client.assert(response.status === 200); });
%}

### 14. A - 존재하지 않는 알림 읽음 처리 -> 404 NOTIFICATION_NOT_FOUND
PATCH {{host}}/notifications/notification-does-not-exist-{{runId}}/read
Authorization: Bearer {{tokenA}}

> {%
client.test("존재하지 않는 알림 404", function () {
    client.assert(response.status === 404, "expected 404, got " + response.status);
    client.assert(response.body.error.code === "NOTIFICATION_NOT_FOUND", "expected NOTIFICATION_NOT_FOUND, got " + response.body.error.code);
});
%}

### 15. A - 모두 읽음 처리
PATCH {{host}}/notifications/read-all
Authorization: Bearer {{tokenA}}

> {%
client.test("모두 읽음 처리 후 안읽은 수 0", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.data.count === 0, "expected 0 unread after read-all, got " + response.body.data.count);
});
%}

### 16. A - 알림 설정 조회 (기본값: 전부 활성화, system은 필수)
GET {{host}}/notifications/settings
Authorization: Bearer {{tokenA}}

> {%
client.test("알림 설정 기본값 7개, system은 required", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    client.assert(response.body.data.length === 7, "expected 7 settings, got " + response.body.data.length);
    response.body.data.forEach(function (s) {
        client.assert(s.enabled === true, "all settings should default to enabled");
    });
    const system = response.body.data.filter(function (s) { return s.category === "system"; })[0];
    client.assert(system.required === true, "system category should be required");
});
%}

### 17. A - 알림 설정 변경 (community, honey_tip 끄기)
PATCH {{host}}/notifications/settings
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{ "settings": [ { "category": "community", "enabled": false }, { "category": "honey_tip", "enabled": false } ] }

> {%
client.test("설정 변경 반영", function () {
    client.assert(response.status === 200, "expected 200, got " + response.status);
    const community = response.body.data.filter(function (s) { return s.category === "community"; })[0];
    const honeyTip = response.body.data.filter(function (s) { return s.category === "honey_tip"; })[0];
    client.assert(community.enabled === false, "community should now be disabled");
    client.assert(honeyTip.enabled === false, "honey_tip should now be disabled");
});
%}

### 18. A - 필수 알림(system) 끄기 시도 -> 400 INVALID_INPUT
PATCH {{host}}/notifications/settings
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{ "settings": [ { "category": "system", "enabled": false } ] }

> {%
client.test("system 끄기 시도 400 INVALID_INPUT", function () {
    client.assert(response.status === 400, "expected 400, got " + response.status);
    client.assert(response.body.error.code === "INVALID_INPUT", "expected INVALID_INPUT, got " + response.body.error.code);
});
%}
